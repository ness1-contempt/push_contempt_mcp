WP_SITE_URL=https://localhost
WP_ADMIN_USER=
WP_ADMIN_PASSWORD=
# Application Password (wp-admin -> Utenti -> Profilo -> Password per le applicazioni),
# usata dai tool "solo script" per chiamare la REST API del plugin push_contempt
# invece del DB diretto (vedi push_contempt_mcp/inventory_tools.py).
WP_APP_USER=
WP_APP_PASSWORD=
# Opzionale: consente ad analizza_seo_sito di analizzare siti su reti private
# (localhost, 192.168.x.x), normalmente rifiutate. Solo per provarlo in locale.
# SEO_ANALISI_CONSENTI_RETE_PRIVATA=1
# Opzionale: dove analizza_seo_sito salva in locale i testi analizzati, usati poi da
# controlla_somiglianza. Predefinita: ~/.cache/push_contempt_mcp/seo_analisi
# SEO_ANALISI_CACHE_DIR=
# Opzionale: attiva per analizza_seo_sito il passaggio a un browser vero (Chromium di
# Playwright, in locale) quando un sito risponde 403/429 o costruisce le pagine con
# JavaScript. Va installato una volta: `uv run playwright install chromium`.
# SEO_ANALISI_USA_BROWSER=1
